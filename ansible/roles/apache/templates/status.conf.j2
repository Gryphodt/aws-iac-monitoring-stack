# ─────────────────────────────────────────────────────────────
# Apache mod_status configuration
#
# Managed by Ansible - role: apache
# Exposes server status for monitoring (Apache Exporter).
# ─────────────────────────────────────────────────────────────

<Location /server-status>
    SetHandler server-status
    Require local
    Require ip 192.168.56.0/24
</Location>

ExtendedStatus On
