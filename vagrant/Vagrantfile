# -*- mode: ruby -*-
# vi: set ft=ruby :

# ─────────────────────────────────────────────────────────────
# Vagrantfile - 3-tier local lab with KVM/libvirt
#
# Defines three VMs based on Rocky Linux 9 (RHEL-compatible):
#   - web         (Apache + app + exporters)  192.168.56.10
#   - db          (MariaDB + node exporter)   192.168.56.20
#   - monitoring  (Prometheus + Grafana)      192.168.56.30
#
# Provider: libvirt (KVM/QEMU)
# Box: generic/rocky9
# ─────────────────────────────────────────────────────────────

Vagrant.configure("2") do |config|

  # ── Global configuration ───────────────────────────────────
  config.vm.box = "generic/rocky9"
  config.vm.box_check_update = false

  # Disable default synced folder (/vagrant) to avoid NFS issues
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # SSH settings
  config.ssh.insert_key = false
  config.ssh.forward_agent = true

  # ── Provider: libvirt (KVM/QEMU) ───────────────────────────
  config.vm.provider :libvirt do |libvirt|
    libvirt.driver = "kvm"
    libvirt.default_prefix = "iac-lab-"
    libvirt.nic_model_type = "virtio"
    libvirt.disk_bus = "virtio"
    libvirt.machine_virtual_size = 20   # GB
  end

  # ───────────────────────────────────────────────────────────
  # VM: web
  # ───────────────────────────────────────────────────────────
  config.vm.define "web" do |web|
    web.vm.hostname = "web"
    web.vm.network "private_network", ip: "192.168.56.10"

    web.vm.provider :libvirt do |libvirt|
      libvirt.memory = 4096
      libvirt.cpus = 2
    end
  end

  # ───────────────────────────────────────────────────────────
  # VM: db
  # ───────────────────────────────────────────────────────────
  config.vm.define "db" do |db|
    db.vm.hostname = "db"
    db.vm.network "private_network", ip: "192.168.56.20"

    db.vm.provider :libvirt do |libvirt|
      libvirt.memory = 4096
      libvirt.cpus = 2
    end
  end

  # ───────────────────────────────────────────────────────────
  # VM: monitoring
  # ───────────────────────────────────────────────────────────
  config.vm.define "monitoring" do |mon|
    mon.vm.hostname = "monitoring"
    mon.vm.network "private_network", ip: "192.168.56.30"

    mon.vm.provider :libvirt do |libvirt|
      libvirt.memory = 6144
      libvirt.cpus = 2
    end
  end

end
